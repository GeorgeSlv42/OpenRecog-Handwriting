{
  "name": "openrecog-handwriting",
  "private": true,
  "workspaces": [
    "ink",
    "app",
    "desktop"
  ],
  "scripts": {
    "start": "npm run start -w @openrecog-handwriting/app",
    "android": "npm run android -w @openrecog-handwriting/app",
    "ios": "npm run ios -w @openrecog-handwriting/app",
    "web": "npm run web -w @openrecog-handwriting/app",
    "desktop": "npm run dev -w @openrecog-handwriting/desktop",
    "test": "npm test -w @openrecog-handwriting/ink && node --test \"recog_mvp/*.test.ts\" \"harness/src/capture/*.test.ts\"",
    "typecheck": "npm run typecheck -w @openrecog-handwriting/ink && npm run typecheck -w @openrecog-handwriting/app",
    "check": "npm run typecheck && npm test"
  }
}
