# ---------------------------------------------------------------------------
# Secrets and credentials — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
!debug.keystore
*.mobileprovision
*.cer
keystore.properties
credentials.json
service-account*.json
google-services.json
GoogleService-Info.plist
# MyScript license certificate (Android: MyCertificate.java, iOS: MyCertificate.c/.h)
**/MyCertificate.*
# Expo / EAS credentials
credentials/
.eas/

# ---------------------------------------------------------------------------
# Personal data — real handwriting is personal data; keep datasets private
# ---------------------------------------------------------------------------
recognition_*/dataset/**
!recognition_*/dataset/TODO.md
!recognition_*/dataset/README.md
# Public datasets downloaded locally (e.g. CROHME, IAM-OnDB) — check licenses, don't redistribute
datasets/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Node / TypeScript
# ---------------------------------------------------------------------------
node_modules/
*.tsbuildinfo
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ---------------------------------------------------------------------------
# Expo / React Native (mobile/)
# ---------------------------------------------------------------------------
.expo/
.expo-shared/
web-build/
expo-env.d.ts
.metro-health-check*
# Native projects generated by `expo prebuild` (the local module's android/ and ios/ are source)
/mobile/android/
/mobile/ios/
*.apk
*.aab
*.ipa

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
.gradle/
**/android/build/
**/android/app/build/
**/android/.cxx/
local.properties
captures/
*.hprof

# ---------------------------------------------------------------------------
